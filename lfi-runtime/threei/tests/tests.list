# name  expected-exit  command...
run forkwait          0 "$RUN" "$OUT/g_forkwait"
run signals           0 "$RUN" "$OUT/g_signals"
run execfd            0 "$RUN" "$OUT/g_execfd" "$OUT/c_hello" "$OUT/c_fdcheck"
run getdents-alias     0 "$RUN" "$OUT/g_getdents" "$OUT/c_readdir"
run mknod             0 "$RUN" "$OUT/c_mknod"
run dupdir            0 "$RUN" "$OUT/c_dupdir"
run exitblocked      3 "$RUN" "$OUT/c_exitblocked"
run perm              0 "$RUN" "$OUT/g_perm"
run compat            0 "$RUN" "$OUT/g_compat" "$OUT/c_compat"
run manyforks         0 "$RUN" "$OUT/g_manyforks"
run geteuid           0 "$RUN" "$OUT/g_geteuid" "$OUT/c_geteuid"
run stack             0 "$RUN" "$OUT/g_stack_a" "$OUT/g_stack_b" "$OUT/c_stack"
run fdtrace           0 "$RUN" "$OUT/g_fdtrace" "$OUT/c_fdio"
run imfs              0 "$RUN" "$OUT/g_imfs" "$OUT/c_imfs"
run conc              0 "$RUN" "$OUT/g_conc" "$OUT/c_conc" 100000
run crash             0 "$RUN" "$OUT/g_crash" "$OUT/g_crash_grate" "$OUT/c_crash"
# Ported from Lind's tests/grate-tests.
run lind/cpdata       0 "$RUN" "$OUT/g_cpdata" "$OUT/c_cpdata"
run lind/cp-stncpy    0 "$RUN" "$OUT/g_cp_stncpy" "$OUT/c_cp_stncpy"
run lind/copy-handler-table 0 "$RUN" "$OUT/g_copy_handler_table" "$OUT/g_copy_handler_table_cage"
run lind/diff-cage-args 0 "$RUN" "$OUT/g_diff_cage_args" "$OUT/c_diff_cage_args"
run lind/fork-with-newret 0 "$RUN" "$OUT/g_fork_with_newret" "$OUT/c_fork_with_newret"
run lind/interpose-fork 0 "$RUN" "$OUT/g_interpose_fork" "$OUT/c_interpose_fork"
run lind/interpose-exec 0 "$RUN" "$OUT/g_interpose_exec" "$OUT/c_interpose_exec"
run lind/interpose-exit 0 "$RUN" "$OUT/g_interpose_exit" "$OUT/c_interpose_exit"
run lind/interpose-mmap 0 "$RUN" "$OUT/g_interpose_mmap" "$OUT/c_interpose_mmap"
run lind/interpose-register 0 "$RUN" "$OUT/g_interpose_register" "$OUT/g_interpose_register_cage"
run lind/multi-register 0 "$RUN" "$OUT/g_multi_register" "$OUT/c_multi_register" "$OUT/c_hello"
run lind/race-test    0 "$RUN" "$OUT/g_race_test" "$OUT/c_race_test"
run lind/thread-race  0 "$RUN" "$OUT/g_thread_race" "$OUT/c_thread_race"
run copyrace          0 "$RUN" "$OUT/g_copyrace" "$OUT/c_copyrace"
run strace             0 "$RUN" "$OUT/g_strace" "$OUT/c_hello"
run shebang            0 "$RUN" "$OUT/g_shebang" "$PWD/$OUT/c_hello"
run net               0 "$RUN" "$OUT/g_net"
run nonet             0 "$RUN" --no-net "$OUT/g_nonet"
run misc              0 "$RUN" "$OUT/g_misc"
run setuid-hidden-ctx  0 "$RUN" "$OUT/g_setuid_cage"
run sighandler        0 "$RUN" "$OUT/g_sighandler"
run siglongjmp         0 "$RUN" "$OUT/g_siglongjmp"
run harsh-exit         0 "$RUN" "$OUT/g_harsh" "$OUT/c_spin" "$OUT/c_hello"
run shm               0 "$RUN" "$OUT/g_shm"
run capture-abuse     0 "$RUN" "$OUT/g_capture" "$OUT/c_capture"
# Signals between threads of one cage (the sender used to deadlock on the thread-list lock).
run threadsig-handler 0   "$RUN" "$OUT/c_threadsig" handler
run threadsig-ignored 0   "$RUN" "$OUT/c_threadsig" ignored
run threadsig-fatal   138 "$RUN" "$OUT/c_threadsig" fatal
run threadsig-race    0   "$RUN" "$OUT/c_threadsig" race
run exitleak          0 "$RUN" --max-cages=24 "$OUT/g_exitleak" "$OUT/c_exitleak" 200
run execimg           0 "$RUN" "$OUT/g_execimg" "$OUT/c_getpid_server"
# Inaccessible memory inside the sandbox: calls fail with EFAULT and nothing else is affected.
run badptr            0 "$RUN" "$OUT/c_badptr"
run faultcopy         0 "$RUN" "$OUT/g_faultcopy" "$OUT/c_faultcopy"
